# Copy to .env and restart Expo. These values are inlined at bundle time.
# The default, with no .env file, is sample data and never calls the store.

# mock | magento
EXPO_PUBLIC_DATA_SOURCE=mock

# Used only when DATA_SOURCE=magento.
EXPO_PUBLIC_MAGENTO_BASE_URL=https://www.metalcloak.com
EXPO_PUBLIC_STORE_WEB_ORIGIN=https://www.metalcloak.com

# Optional Magento store-view code, sent as the Store header.
# EXPO_PUBLIC_MAGENTO_STORE_CODE=default

# graphql (customer token, preferred) | rest (admin ACL, usually denied)
EXPO_PUBLIC_ORDERS_API=graphql

# amasty-rest | amasty-graphql | custom
EXPO_PUBLIC_REWARDS_PROFILE=amasty-rest
EXPO_PUBLIC_REWARDS_BALANCE_PATH=/rest/V1/rewards/mine/balance
EXPO_PUBLIC_REWARDS_HISTORY_PATH=/rest/V1/rewards/mine/history

# Required before any request whose host is metalcloak.com.
# Leave false until MetalCloak has confirmed API access.
EXPO_PUBLIC_ALLOW_LIVE_STORE=false
